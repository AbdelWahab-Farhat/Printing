# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors / IDEs ───────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ── Secrets (never commit; .env.example is the committed template) ────
.env
.env.*
!.env.example
*.pem
*.key

# ── Claude / agent local state ───────────────────────────────────────
.claude/settings.local.json

# ── Generated API spec is committed (Docs/openapi.json); scratch is not
Docs/*.tmp.json

# NOTE: backend/ and frontend/ each carry their own .gitignore
# (vendor/, node_modules/, build/, .dart_tool/, storage/ …).

# ── Customer personal data (never commit; this repository is public) ──────────
# The customer book is 574 real names and telephone numbers. It is copied to each
# server out of band and read by CustomerSeeder, which says so when it is absent.
backend/storage/*.xlsx
backend/database/seeders/data/customers.php
