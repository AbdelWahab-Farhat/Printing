# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors / IDEs ───────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ── Secrets (never commit; .env.example is the committed template) ────
.env
.env.*
!.env.example
*.pem
*.key

# ── Claude / agent local state ───────────────────────────────────────
.claude/settings.local.json

# ── Generated API spec is committed (Docs/openapi.json); scratch is not
Docs/*.tmp.json

# NOTE: backend/ and frontend/ each carry their own .gitignore
# (vendor/, node_modules/, build/, .dart_tool/, storage/ …).
