# The keys the app expects. One file per Flavor — copy this to each and fill it in:
#
#   .env       prod  — the default, and what ships. Built with no --dart-define at all.
#   .env.dev   dev   — `--dart-define=FLAVOR=dev`
#
# This file is committed; the two it describes are not. Both must also be listed under `assets:`
# in pubspec.yaml, or that flavour throws at launch rather than failing to build.

# API root, including /api/v1.
BASE_URL=

# Development only. The Android emulator reaches the host machine at 10.0.2.2, not 127.0.0.1 —
# leave this out of .env and AppConfig will fall back to BASE_URL.
BASE_URL_ANDROID=
