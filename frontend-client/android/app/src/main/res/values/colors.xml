<?xml version="1.0" encoding="utf-8"?>
<!--
  The one place Android needs to know the app's colour.

  The window is painted by the OS before Flutter has drawn a frame, so `ColorScheme` cannot
  reach it, and it has to be stated again here. This is the daylight page,
  `MaterialTheme.lightScheme.surface`; `values-night/colors.xml` holds the night one. Without
  the pair, a phone in dark mode would flash the light page on every cold start, or the other
  way round.

  Kept in step with `theme.dart` by hand. There is no generator between the two.
-->
<resources>
    <color name="brand_surface">#F7F6FB</color>

    <!--
      Written by `dart run flutter_launcher_icons` from `adaptive_icon_background` in
      pubspec.yaml, and rewritten every time it runs. Change it there, not here.

      White, because the Daaya logo was drawn on white.
    -->
    <color name="ic_launcher_background">#ffffff</color>
</resources>
