<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against a dedicated PostgreSQL database so the suite exercises the same
             driver as production. Create it once: createdb printing_bags_test -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="printing_bags_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- The carrier is pinned off here so a developer's own .env cannot reach the suite:
             a shipping_companies id that exists on their box and not in the test database made
             every dispatch test a foreign-key error. -->
        <env name="NAWRIS_SHIPPING_COMPANY_ID" value=""/>
        <!-- EzonePay likewise: a developer trying the top-up on an emulator with
             EZONE_PAY_DRIVER=fake turned every OnlineTopUpTest case onto the pretend gateway.
             Off and real here; each test switches on what it needs. -->
        <env name="EZONE_PAY_ENABLED" value="false"/>
        <env name="EZONE_PAY_DRIVER" value="ezonepay"/>
        <!-- And never a developer's real sandbox credentials: a test that forgot its HTTP fake
             would otherwise sign in to EzonePay for real. Tests set what they need. -->
        <env name="EZONE_PAY_BASE_URL" value="https://ezone.invalid"/>
        <env name="EZONE_PAY_EMAIL" value=""/>
        <env name="EZONE_PAY_PASSWORD" value=""/>
        <env name="EZONE_PAY_SHOP_ID" value=""/>
        <env name="EZONE_PAY_WEBHOOK_SECRET" value=""/>
    </php>
</phpunit>
