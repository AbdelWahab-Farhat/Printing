<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Every screen in this app reads from the API, so without this a release build is an app
        that cannot do anything at all.

        Flutter's template puts INTERNET only in the debug and profile manifests, which is why
        this was never noticed: `flutter run` merges those in and works perfectly, and the first
        build that fails is the signed one handed to somebody.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!--
            Opening a customer's design in whatever the phone already uses for PDFs.

            Android 11 hid the list of installed apps, so without this declaration the launch
            resolves to nothing and the tap does nothing at all — silently, on Android 11 and
            up only, which is every phone this will run on. This is the whole configuration
            url_launcher needs.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

    <!--
        No CAMERA permission, and that is deliberate rather than an oversight.

        `image_picker` starts the system camera app through an intent, which needs none. But
        Android has a trap here: if an app *declares* CAMERA, the OS starts requiring a runtime
        grant for that same intent — and nothing in this app asks for one, so declaring it would
        break the button it looks like it enables.
    -->
</manifest>
