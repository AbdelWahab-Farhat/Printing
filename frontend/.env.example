# The keys the app expects. One file per Flavor — copy this to each and fill it in:
#
#   .env       prod  — the default, and what ships. Built with no --dart-define at all.
#   .env.dev   dev   — `--dart-define=FLAVOR=dev`
#
# This file is committed; the two it describes are not. Both must also be listed under `assets:`
# in pubspec.yaml, or that flavour throws at launch rather than failing to build.

# API root, including /api/v1.
BASE_URL=

# Development only. The Android emulator reaches the host machine at 10.0.2.2, not 127.0.0.1 —
# leave this out of .env and AppConfig will fall back to BASE_URL.
BASE_URL_ANDROID=

# ── map ──────────────────────────────────────────────────────────────────────
# Both have working defaults in AppConfig, so leaving them empty is fine. They exist so a move
# off OpenStreetMap's public servers — whose policy allows withdrawing access from commercial
# users at any time — is a config change rather than a release.
MAP_TILE_URL=
GEOCODER_BASE_URL=

# ── البثّ الحيّ (Reverb) ─────────────────────────────────────────────────────
# تذاكر الدعم حيّةٌ عبر خادم Reverb. **فارغاً يعني بلا بثّ**: الشاشات تعمل بالسحب كما كانت.
# REVERB_APP_KEY عامٌّ لا سرّ فيه — هو REVERB_APP_KEY في backend/.env على الخادم نفسه.
# المضيفُ والمخطّط يُشتقّان من BASE_URL (https ← wss)، فلا يُكتبان إلا لخادم بثٍّ على مضيفٍ آخر.
# REVERB_PORT: ‏8080 تطويراً (reverb:start مباشرةً)، وفارغاً في الإنتاج (٤٤٣ خلف nginx).
REVERB_APP_KEY=
REVERB_PORT=
# REVERB_HOST=
# REVERB_SCHEME=
